  object pnlToolbar: TFlowPanel
    Left = 4
    Height = 34
    Top = 4
    Width = 952
    Align = alTop
    AutoSize = True
    AutoWrap = True
    BevelOuter = bvNone
    BorderSpacing.Left = 4
    BorderSpacing.Top = 4
    BorderSpacing.Right = 4
    BorderSpacing.Bottom = 4
