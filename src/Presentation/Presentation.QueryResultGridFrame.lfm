object QueryResultGridFrame: TQueryResultGridFrame
  Left = 0
  Height = 240
  Top = 0
  Width = 640
  ClientHeight = 240
  ClientWidth = 640
  TabOrder = 0
  object grdResults: TDrawGrid
    Left = 0
    Height = 214
    Top = 0
    Width = 640
    Align = alClient
    ColCount = 1
    DefaultColWidth = 140
    DefaultRowHeight = 22
    FixedCols = 0
    Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRangeSelect, goDrawFocusSelected, goColSizing, goThumbTracking]
    PopupMenu = pmGrid
    RowCount = 1
    TabOrder = 0
    OnDrawCell = grdResultsDrawCell
    OnHeaderClick = grdResultsHeaderClick
    OnKeyDown = grdResultsKeyDown
    OnMouseDown = grdResultsMouseDown
    OnTopLeftChanged = grdResultsTopLeftChanged
  end
  object pnlGridFooter: TPanel
    Left = 0
    Height = 26
    Top = 214
    Width = 640
    Align = alBottom
    AutoSize = True
    BevelOuter = bvLowered
    ClientHeight = 26
    ClientWidth = 640
    Constraints.MinHeight = 26
    TabOrder = 1
    object lblGridSummary: TLabel
      Left = 5
      Height = 16
      Top = 5
      Width = 630
      Align = alClient
      BorderSpacing.Around = 4
      Caption = 'Nenhuma consulta executada.'
      Font.Style = [fsBold]
      ParentFont = False
      ShowAccelChar = False
    end
  end
  object dlgSaveCsv: TSaveDialog
    DefaultExt = '.csv'
    Filter = 'CSV Files (*.csv)|*.csv|Todos os arquivos (*.*)|*.*'
    Left = 240
    Top = 80
  end
  object pmGrid: TPopupMenu
    OnPopup = pmGridPopup
    Left = 160
    Top = 80
    object miCopyCell: TMenuItem
      Caption = 'Copiar Valor da Célula'
      ShortCut = 16451
      OnClick = miCopyCellClick
    end
    object miCopySelection: TMenuItem
      Caption = 'Copiar Seleção (TSV)'
      OnClick = miCopySelectionClick
    end
    object miCopyRow: TMenuItem
      Caption = 'Copiar Linha'
      OnClick = miCopyRowClick
    end
    object miCopyRowWithHeader: TMenuItem
      Caption = 'Copiar Linha com Cabeçalhos'
      OnClick = miCopyRowWithHeaderClick
    end
    object miGridSep1: TMenuItem
      Caption = '-'
    end
    object miCopyColName: TMenuItem
      Caption = 'Copiar Nome da Coluna'
      OnClick = miCopyColNameClick
    end
    object miGridSep2: TMenuItem
      Caption = '-'
    end
    object miExportCsv: TMenuItem
      Caption = 'Exportar CSV...'
      OnClick = miExportCsvClick
    end
  end
end
